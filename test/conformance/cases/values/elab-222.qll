{ effect Log = sig { write : I64 -> I64 }; effect Exc = sig { raise : I64 -> I64 }; log_map = fn(f : I64 ~> I64, x : I64) ~> I64 { perform Log.write(f(x)) }; boom : I64 ->{Exc} I64 = fn(n) { perform Exc.raise(n) }; a = match (log_map(fn(n : I64) { n + 1 }, 1)) { v => v, effect Log.write n => n }; b = match (match (log_map(boom, 5)) { v => v, effect Log.write n => n }) { v => v, effect Exc.raise n => n * 100 }; a + b }
