{ effect State(S) = sig { get : Unit -> S }; f : Unit ->{State(I64)} I64 = fn(_) { perform State.get () }; app = fn(g : Unit ~> I64) { g() }; twice : (Unit ~> I64) -> Unit ~> I64 = fn(g) { fn(_) { g() + g() } }; S = sig { cb : (Unit ~> I64) ~> I64 }; R = struct { cb : (Unit ~> I64) ~> I64 }; ((1, 2) : Tuple(2, I64, I64)); (fn(_) { app(twice(f)) } : Unit ->{State(I64)} I64) }
